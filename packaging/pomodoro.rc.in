// Embeds the application icon into the Windows executable, so Explorer, the taskbar
// and shortcuts show the logo instead of the generic exe glyph. The icon shown while
// the window is running still comes from setWindowIcon in main.cpp; this is only what
// the file itself looks like.
//
// Configured by CMake so the path is absolute: MSVC's rc.exe resolves relative paths
// against the .rc file, windres against the working directory, and this sidesteps both.
IDI_ICON1 ICON "@POMODORO_WINDOWS_ICON@"

// Without a version resource Windows has no display name for an unpackaged executable,
// so the media flyout, the volume mixer and the task manager all fall back to calling it
// "Unknown app". FileDescription is the string those surfaces read.
1 VERSIONINFO
FILEVERSION     @POMODORO_VERSION_COMMA@
PRODUCTVERSION  @POMODORO_VERSION_COMMA@
FILEOS          0x4L    // VOS_NT_WINDOWS32
FILETYPE        0x1L    // VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		// 040904b0: US English, Unicode. The block name has to match the Translation
		// value below or Windows ignores the whole table.
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName",      "elhiba"
			VALUE "FileDescription",  "Pomodoro"
			VALUE "FileVersion",      "@PROJECT_VERSION@"
			VALUE "InternalName",     "pomodoro"
			VALUE "OriginalFilename", "pomodoro.exe"
			VALUE "ProductName",      "Pomodoro"
			VALUE "ProductVersion",   "@PROJECT_VERSION@"
		END
	END

	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
