    <qresource prefix="/">
        <file alias="closeButton">../assets/icons/close.svg</file>
        <file alias="maximizeButton">../assets/icons/maximize.svg</file>
        <file alias="maximizeReverseButton">../assets/icons/maximizeReverse.svg</file>
        <file alias="minimizeButton">../assets/icons/minimize.svg</file>

        <file alias="PlaywriteARFont">../assets/fonts/PlaywriteAR.ttf</file>
        <file alias="JetBrainsMonoFont">../assets/fonts/JetBrainsMono.ttf</file>

		<file alias="CircularTimerTemplate">../assets/qrc/CircularTimer.qml</file>

		<file alias="playTimer">../assets/icons/playTimer.svg</file>
		<file alias="pauseTimer">../assets/icons/pauseTimer.svg</file>

		<file alias="pomodoroLogo.png">../assets/icons/pomodoroLogo.png</file>
